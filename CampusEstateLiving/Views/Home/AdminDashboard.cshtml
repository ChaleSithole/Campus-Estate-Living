@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator";
    var occPct = Model.ActiveRooms == 0 ? 0 : (int)Math.Round(Model.OccupiedRooms * 100.0 / Model.ActiveRooms);
}
<div class="page">
    <partial name="_Alerts" />
    <div class="page-head reveal">
        <div>
            <p class="kicker">Agent head</p>
            <h1>Estate overview</h1>
        </div>
        <div class="toolbar">
            <a class="btn-gold" asp-controller="Admin" asp-action="CreateUser">Add user</a>
            <a class="btn-outline" asp-controller="Notices" asp-action="Create">Post a notice</a>
            <a class="btn-outline" asp-controller="Admin" asp-action="Reports">Reports</a>
        </div>
    </div>
    <div class="cards-4" style="margin-bottom:1rem">
        <div class="card reveal"><div class="stat-value">@Model.ResidentCount</div><div class="stat-label">Resident accounts</div></div>
        <div class="card reveal" style="--d:40ms">
            <div class="stat-value">@Model.OccupiedRooms / @Model.ActiveRooms</div>
            <div class="stat-label">Rooms occupied · @occPct%</div>
            <div class="meter" style="margin-top:0.7rem"><div class="meter-track"><span style="width:@occPct%"></span></div></div>
        </div>
        <div class="card reveal" style="--d:80ms"><div class="stat-value">@Model.PendingPayments</div><div class="stat-label">Pending payments</div></div>
        <div class="card reveal" style="--d:120ms"><div class="stat-value">@Model.OpenMaintenance</div><div class="stat-label">Open maintenance</div></div>
    </div>
    <div class="split">
        <div class="card reveal">
            <h3>Latest payments</h3>
            @if (!Model.RecentPayments.Any())
            {
                <p class="empty">No payments recorded yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th>Resident</th><th>Service</th><th>Amount</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td>@p.Account.User.Person.FullName</td>
                                <td>@p.Category.CategoryName</td>
                                <td>@p.Amount.ToString("C")</td>
                                <td><partial name="_Status" model="p.PaymentStatus.StatusName" /></td>
                                <td><a asp-controller="Financial" asp-action="Receipt" asp-route-id="@p.PaymentId">Receipt</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <p class="muted" style="margin-top:0.8rem">@Model.OfficerCount financial officer@(Model.OfficerCount == 1 ? "" : "s") authorised · pending queue @Model.PendingAmount.ToString("C") · confirmed this month @Model.ConfirmedThisMonth.ToString("C")</p>
        </div>
        <div class="card reveal" style="--d:80ms">
            <h3>This month by service</h3>
            <partial name="_CategoryBars" model="Model.TotalsByCategory" />
            <h3 style="margin-top:1.25rem">Notices</h3>
            @if (!Model.Notices.Any())
            {
                <p class="empty">No published notices.</p>
            }
            else
            {
                @foreach (var n in Model.Notices)
                {
                    <div class="notice-inline"><strong>@n.Title</strong><div class="muted">@n.Body</div></div>
                }
            }
            <h3 style="margin-top:1.25rem">New logins</h3>
            @if (!Model.RecentUsers.Any())
            {
                <p class="empty">No users yet.</p>
            }
            else
            {
                <ul class="plain-list">
                    @foreach (var u in Model.RecentUsers)
                    {
                        <li>
                            <a asp-controller="Admin" asp-action="UserDetails" asp-route-id="@u.Id">@u.Person.FullName</a>
                            <span class="muted"> · @u.Email</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
