@{
    ViewData["Title"] = "Privacy";
}
<div class="page">
    <div class="card" style="max-width:720px">
        <p class="kicker">Campus Estate Living</p>
        <h1>Privacy</h1>
        <p>Personal information is collected to operate campus estate accounts: identity, student or employee numbers, accommodation, and payment records.</p>
        <p>Card numbers are never stored in full. Only the card brand, last four digits, expiry and a token are kept. Bank account numbers are stored as the last four digits plus branch metadata.</p>
        <p>Administrator and financial-officer logins are separate from resident logins. Permissions follow the signed-in user account, not the person record.</p>
    </div>
</div>
