@model EditUserViewModel
@{
    ViewData["Title"] = "Update resident";
}
<div class="page">
    <div class="card form-card">
        <h1>Update resident</h1>
        <form asp-action="EditUser" method="post" class="form-grid">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="PersonId" />
            <input type="hidden" asp-for="Role" />
            <input type="hidden" asp-for="IsActive" />
            <div class="form-grid two">
                <div>
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <div>
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control" />
                </div>
            </div>
            <div>
                <label asp-for="UserNumber"></label>
                <input asp-for="UserNumber" class="form-control" />
            </div>
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div>
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            @if (Model.AccountStatus != null)
            {
                <div>
                    <label asp-for="AccountStatus"></label>
                    <select asp-for="AccountStatus" class="form-control">
                        <option>Active</option>
                        <option>Inactive</option>
                        <option>Suspended</option>
                    </select>
                </div>
            }
            <button class="btn-primary" type="submit">Save</button>
        </form>
    </div>
</div>
