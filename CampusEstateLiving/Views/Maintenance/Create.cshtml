@model MaintenanceCreateViewModel
@{
    ViewData["Title"] = "Log maintenance";
}
<div class="page">
    <div class="card form-card reveal">
        <p class="kicker">Resident request</p>
        <h1>Log a maintenance issue</h1>
        <p><a class="btn-outline btn-sm" asp-action="Index">← Back to maintenance</a></p>
        <p class="muted">The estate office will see this immediately. Use Urgent only for safety or a leak that cannot wait.</p>
        <form asp-action="Create" method="post" class="form-grid">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid two">
                <div>
                    <label asp-for="Category"></label>
                    <select asp-for="Category" class="form-control">
                        @foreach (var c in MaintenanceCategories.All)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="Priority"></label>
                    <select asp-for="Priority" class="form-control">
                        @foreach (var p in MaintenancePriorities.All)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
            </div>
            <div>
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" placeholder="Short description" />
                <span asp-validation-for="Title"></span>
            </div>
            <div>
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Where it is, when it started, and anything the artisan should know."></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <button class="btn-gold" type="submit">Submit request</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
