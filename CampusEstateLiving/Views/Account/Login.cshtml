@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-wrap">
    <div class="auth-card reveal">
        <img class="auth-logo" src="~/images/logo-sm.png" alt="Campus Estate Living" />
        <h1>Sign in</h1>
        <p class="sub">Use your campus estate account.</p>
        <partial name="_Alerts" />
        <form asp-action="Login" method="post" class="form-grid">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="password-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <button class="password-toggle" type="button" data-toggle-password="Password">Show</button>
                <span asp-validation-for="Password"></span>
            </div>
            <label class="remember">
                <input asp-for="RememberMe" /> Remember me on this device
            </label>
            <button class="btn-primary" type="submit">Sign in</button>
        </form>
        <p class="muted" style="margin-top:1rem;text-align:center">
            Student or staff? <a asp-action="Register">Create an account</a>
        </p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
