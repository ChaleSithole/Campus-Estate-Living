@{
    ViewData["Title"] = "Configured tariffs";
    var tariffs = ViewBag.Tariffs as List<Tariff> ?? [];
    var activeCount = tariffs.Count(t => t.IsActive);
}
<div class="page">
    <partial name="_Alerts" />
    <div class="page-head">
        <div>
            <p class="kicker">Administrator controls</p>
            <h1>Configured tariffs</h1>
            <p class="muted">Review and update the service prices currently configured for the estate.</p>
        </div>
        <a class="btn-outline" asp-action="Management">← Back to management</a>
    </div>

    <div class="cards-3" style="margin-bottom:1rem">
        <section class="card"><p class="muted">Total tariffs</p><strong>@tariffs.Count</strong></section>
        <section class="card"><p class="muted">Active and available</p><strong>@activeCount</strong></section>
        <section class="card"><p class="muted">Inactive</p><strong>@(tariffs.Count - activeCount)</strong></section>
    </div>

    <section class="card">
        <div class="page-head">
            <div>
                <h2>Current service prices</h2>
                <p class="muted">Edit the amount, billing unit, or availability, then save that tariff.</p>
            </div>
            @if (tariffs.Count > 0)
            {
                <input type="search" class="form-control" placeholder="Search service or tariff" aria-label="Search configured tariffs" data-tariff-filter style="max-width:20rem" />
            }
        </div>
        @if (tariffs.Count == 0)
        {
            <p class="muted">There are no tariffs configured.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Service / tariff</th><th>Price and availability</th></tr></thead>
                    <tbody>
                    @foreach (var tariff in tariffs)
                    {
                        <tr data-tariff-row data-tariff-search="@(tariff.Category.CategoryName + " " + tariff.TariffName)">
                            <td><strong>@tariff.Category.CategoryName</strong><br />@tariff.TariffName</td>
                            <td>
                                <form asp-action="UpdateTariff" asp-route-id="@tariff.TariffId" method="post" class="toolbar tariff-edit-form">
                                    <label>Amount (ZAR)<input name="amount" type="number" min="0.01" max="1000000" step="0.01" value="@tariff.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required /></label>
                                    <label>Billing unit<input name="unit" value="@tariff.Unit" maxlength="40" class="form-control" required /></label>
                                    <label class="choice"><input name="isActive" type="checkbox" value="true" checked="@tariff.IsActive" /> Available to residents</label>
                                    <input name="isActive" type="hidden" value="false" />
                                    <button class="btn-outline btn-sm" type="submit">Save changes</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="hint" data-tariff-empty hidden>No matching tariffs. Try another search.</p>
        }
    </section>
</div>
