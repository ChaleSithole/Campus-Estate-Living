@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    if (user != null)
    {
        var db = Context.RequestServices.GetRequiredService<CampusEstateLiving.Data.ApplicationDbContext>();
        await db.Entry(user).Reference(u => u.Person).LoadAsync();
    }
    string RoleLabel()
    {
        if (User.IsInRole(AppRoles.Administrator)) return "Administrator";
        if (User.IsInRole(AppRoles.FinancialOfficer)) return "Financial Officer";
        if (User.IsInRole(AppRoles.Staff)) return "Staff";
        if (User.IsInRole(AppRoles.Student)) return "Student";
        return "";
    }
    bool Nav(string controller, string? action = null)
        => string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
           && (action == null || string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Campus Estate Living") · UFS QwaQwa</title>
    <link rel="icon" type="image/png" href="~/images/favicon-64.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="siteHeader">
        <nav class="navbar-cel">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/app-icon-192.png" alt="Campus Estate Living" />
                <span class="brand-text">
                    <strong>Campus Estate Living</strong>
                    <span>UFS QwaQwa Campus</span>
                </span>
            </a>
            <button class="nav-toggle" type="button" id="navToggle" aria-label="Open menu" aria-controls="siteNav" aria-expanded="false">Menu</button>
            <div class="site-nav" id="siteNav">
            <div class="nav-links">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="@(Nav("Home","Dashboard") ? "active" : null)" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                    @if (User.IsInRole(AppRoles.Administrator))
                    {
                        <a class="@(Nav("Admin","Users") || Nav("Admin","Students") || Nav("Admin","Staff") ? "active" : null)" asp-controller="Admin" asp-action="Users">Users</a>
                        <a class="@(Nav("Admin","Management") || Nav("Admin","Officers") ? "active" : null)" asp-controller="Admin" asp-action="Management">Management</a>
                        <a class="@(Nav("Admin","Rooms") || Nav("Admin","Properties") || Nav("Admin","Assignments") ? "active" : null)" asp-controller="Admin" asp-action="Rooms">Estate</a>
                        <a class="@(Nav("Admin","Payments") ? "active" : null)" asp-controller="Admin" asp-action="Payments">Payments</a>
                        <a class="@(Nav("Notices") ? "active" : null)" asp-controller="Notices" asp-action="Index">Notices</a>
                        <a class="@(Nav("Maintenance") ? "active" : null)" asp-controller="Maintenance" asp-action="Index">Maintenance</a>
                        <a class="@(Nav("Admin","Reports") ? "active" : null)" asp-controller="Admin" asp-action="Reports">Reports</a>
                    }
                    else if (User.IsInRole(AppRoles.FinancialOfficer))
                    {
                        <a class="@(Nav("Financial","Users") ? "active" : null)" asp-controller="Financial" asp-action="Users">Residents</a>
                        <a class="@(Nav("Financial","Payments") ? "active" : null)" asp-controller="Financial" asp-action="Payments">Payments</a>
                        <a class="@(Nav("Financial","Record") ? "active" : null)" asp-controller="Financial" asp-action="Record">Record</a>
                        <a class="@(Nav("Maintenance") ? "active" : null)" asp-controller="Maintenance" asp-action="Index">Maintenance</a>
                        <a class="@(Nav("Financial","Reports") ? "active" : null)" asp-controller="Financial" asp-action="Reports">Reports</a>
                    }
                    else
                    {
                        <a class="@(Nav("Accommodation") ? "active" : null)" asp-controller="Accommodation" asp-action="Index">Accommodation</a>
                        <a class="@(Nav("Payments","Create") ? "active" : null)" asp-controller="Payments" asp-action="Create">Pay</a>
                        <a class="@(Nav("Payments","Index") || Nav("Payments","Statement") ? "active" : null)" asp-controller="Payments" asp-action="Index">History</a>
                        <a class="@(Nav("Maintenance") ? "active" : null)" asp-controller="Maintenance" asp-action="Index">Maintenance</a>
                        <a class="@(Nav("Notices") ? "active" : null)" asp-controller="Notices" asp-action="Index">Notices</a>
                    }
                    <a class="@(Nav("Home","Help") ? "active" : null)" asp-controller="Home" asp-action="Help">Help</a>
                    <a class="@(Nav("Profile","Index") ? "active" : null)" asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="Help">Help</a>
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
            <div class="nav-end">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="bell" asp-controller="Notifications" asp-action="Index" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @await Component.InvokeAsync("NotificationBadge")
                    </a>
                    <div class="user-chip">
                        <strong>@(user?.Person.FullName ?? user?.Email)</strong>
                        <span>@RoleLabel()</span>
                    </div>
                    <button class="btn-ghost btn-sm" type="button" data-open-signout>Sign out</button>
                }
                else
                {
                    <a class="btn-gold btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </div>
            </div>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer no-print">
        <div class="footer-inner">
            <div>
                <strong>Campus Estate Living</strong>
                <div>University of the Free State · QwaQwa Campus</div>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Help">Help & contacts</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span>Estate office 058 718 5000</span>
            </div>
        </div>
    </footer>

    @if (SignInManager.IsSignedIn(User))
    {
        <div class="modal-backdrop" data-signout-modal hidden>
            <section class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirmSignoutTitle" aria-describedby="confirmSignoutDescription">
                <h2 id="confirmSignoutTitle">Sign out?</h2>
                <p id="confirmSignoutDescription">You’ll need to sign in again to access your account.</p>
                <div class="toolbar">
                    <button class="btn-outline" type="button" data-cancel-signout>Stay signed in</button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn-gold" type="submit">Sign out</button>
                    </form>
                </div>
            </section>
        </div>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
