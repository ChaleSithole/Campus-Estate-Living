<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Hero: greeting, role, account line -->
    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_hero"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/heroEyebrow"
            style="@style/TextEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold_light" />

        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@color/gold" />

        <TextView
            android:id="@+id/heroName"
            style="@style/TextHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/heroSub"
            style="@style/TextHeroSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Inactive notice (shown only when the account is inactive) -->
    <LinearLayout
        android:id="@+id/inactiveCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_card"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/pad_card"
        android:visibility="gone">

        <TextView
            style="@style/TextCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/danger"
            android:text="Account inactive" />

        <TextView
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="0dp"
            android:paddingTop="4dp"
            android:text="Please contact the campus estate office to restore your account." />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Favourites"
        android:textColor="@color/text_heading"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Quick actions, filled from code (role-dependent) -->
    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_card"
        android:orientation="horizontal" />

    <!-- Resident block -->
    <LinearLayout
        android:id="@+id/residentBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/roomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_card"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/pad_card">

            <TextView
                style="@style/TextEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accommodation" />

            <LinearLayout
                android:id="@+id/roomEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="No room assigned" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You do not have an active room assignment yet. The estate office allocates spaces before term begins." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/roomFilled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/roomBuilding"
                    style="@style/TextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/roomNumber"
                    style="@style/TextFigure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/roomStatus"
                    style="@style/TextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Two figures side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_card"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/gap_tile"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="18dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/dash_gold" />

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending balance" />

                <TextView
                    android:id="@+id/pendingValue"
                    style="@style/TextFigure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gap_tile"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="18dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/dash_gold" />

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unread alerts" />

                <TextView
                    android:id="@+id/unreadValue"
                    style="@style/TextFigure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recent payments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_card"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent payments" />

                <TextView
                    android:id="@+id/viewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="View all ›"
                    android:textColor="@color/text_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/recentEmpty"
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="0dp"
                android:text="No payment history on record."
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Staff block -->
    <LinearLayout
        android:id="@+id/staffBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_card"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/gap_tile"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending queue" />

                <TextView
                    android:id="@+id/queueValue"
                    style="@style/TextFigure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gap_tile"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmed total" />

                <TextView
                    android:id="@+id/confirmedValue"
                    style="@style/TextFigure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reportCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_card"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad_card"
            android:visibility="gone">

            <TextView
                style="@style/TextEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly overview" />

            <TextView
                style="@style/TextCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Financial reconciliation" />

            <TextView
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Total payments processed" />

            <TextView
                android:id="@+id/reportCount"
                style="@style/TextValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Confirmed amount" />

            <TextView
                android:id="@+id/reportAmount"
                style="@style/TextValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/staffActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Unread alerts row, filled from code -->
    <LinearLayout
        android:id="@+id/alertsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>